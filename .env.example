# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Memgraph ─────────────────────────────────────────────────────────────────
# Automatically set to bolt://memgraph:7687 inside Docker.
# Override for local development outside Docker:
# MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── LlamaIndex ────────────────────────────────────────────────────────────────
# Directory of documents to index on startup (optional)
LLAMA_DOCS_DIR=data/docs
