# ── OpenAI ───────────────────────────────────────────────────────────────────
BACKEND=core42
OPENAI_API_KEY="your_compass_key_here"
OPENAI_BASE_URL="https://compass.core42.ai/v1"
OPENAI_MODEL="gpt-4.1"
EMBEDDING_MODEL="text-embedding-3-large"
USE_CASE_ID="16"

# ── Memgraph ─────────────────────────────────────────────────────────────────
# Single-container Docker runs Memgraph in the same container as the API.
# Override only if you want to point the app at an external Memgraph instance.
MEMGRAPH_URI=bolt://127.0.0.1:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ── LlamaIndex ────────────────────────────────────────────────────────────────
# Directory of documents to index on startup (optional)
LLAMA_DOCS_DIR=data/docs
